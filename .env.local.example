# Copy this file to .env.local (which is gitignored) and fill in your Supabase project's
# values: Project Settings → API in the Supabase dashboard.
#
# Only the URL and the anon/public key ever go here — never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
